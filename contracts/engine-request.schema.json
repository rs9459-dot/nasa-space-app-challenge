{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmline/contracts/engine-request.schema.json",
  "title": "FarmLine engine request (POST /plan)",
  "description": "Contract B, worker -> engine. Owner: Abdullah. Sent with 'Authorization: Bearer <ENGINE_API_TOKEN>'. Give one way to find the field: field_id, zip, place, or lat+lon (the engine tries them in that order, resolving zip/place through data/reference/places.csv). Priorities should add up to 1; the engine renormalises them anyway.",
  "type": "object",
  "additionalProperties": false,
  "required": ["priorities"],
  "properties": {
    "field_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "zip": { "type": ["string", "null"], "pattern": "^[0-9]{5,6}$", "description": "US ZIP (5 digits) or Indian PIN (6 digits)." },
    "place": { "type": ["string", "null"], "minLength": 1, "maxLength": 100, "description": "Town, village or district name as the farmer wrote it." },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "current_crop": {
      "anyOf": [{ "$ref": "#/$defs/cropCode" }, { "type": "null" }],
      "description": "What the farmer grows now; the baseline. Null = use the field's latest CDL crop."
    },
    "priorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["water", "income", "drought"],
      "properties": {
        "water": { "type": "number", "minimum": 0, "maximum": 1 },
        "income": { "type": "number", "minimum": 0, "maximum": 1 },
        "drought": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "anyOf": [
    { "required": ["field_id"], "properties": { "field_id": { "type": "string" } } },
    { "required": ["zip"], "properties": { "zip": { "type": "string" } } },
    { "required": ["place"], "properties": { "place": { "type": "string" } } },
    { "required": ["lat", "lon"], "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } } }
  ],
  "$defs": {
    "cropCode": {
      "description": "Same codes as worker/src/gemini/crops.ts. Add new codes there first.",
      "enum": [
        "alfalfa", "wheat", "barley", "sorghum", "dry_beans", "safflower", "corn", "corn_silage",
        "cover_crop", "fallow", "rice", "cotton", "mustard", "chickpea", "millet", "sugarcane"
      ]
    }
  },
  "examples": [
    { "zip": "89406", "current_crop": "alfalfa", "priorities": { "water": 0.5, "income": 0.25, "drought": 0.25 } },
    { "field_id": "nv-fallon-01", "current_crop": null, "priorities": { "water": 0.34, "income": 0.33, "drought": 0.33 } }
  ]
}
